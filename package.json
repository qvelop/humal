    "humal": "bin/humal.js"
  },
  "scripts": {
    "test": "node bin/humal.js examples/basic.hum",
    "build": "node bin/humal.js build"
  },
  "keywords": [
    "programming-language",
    "compiler",
    "javascript",
    "typescript",
    "humal",
    "human",
    "transpiler",
    "js",
    "ts",
    "indentation",
    "esm",
    "commonjs"
  ],
  "files": [
    "bin",
    "src",
    "examples",
    "assets/image/humal-logo.png",
    "README.md",
    "LICENSE",
    "eslint.config.cjs"
  ],
  "author": {
    "name": "qvelop",
    "url": "https://github.com/qvelop"
  },
  "license": "Apache-2.0",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qvelop/humal.git"
  },
  "homepage": "https://humal.netlify.app",
  "bugs": {
    "url": "https://github.com/qvelop/humal/issues"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/readline-sync": "^1.4.8",
    "chokidar": "^4.0.3",
    "eslint": "^10.11.0",
    "express": "^5.2.1",
